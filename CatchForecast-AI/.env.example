# ==============================================================================
# CatchForecast AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file or credentials to source control.

# Google Earth Engine Configuration
EE_PROJECT_ID=your-gee-cloud-project-id
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# Path to private key JSON if using service account authentication
EE_PRIVATE_KEY_FILE=

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catchforecast_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage & Cache Configuration
STORAGE_BACKEND=local # local | gcs | s3
MODEL_REGISTRY_PATH=./models
CACHE_TTL_SECONDS=3600
