# Backups & Environment
_backups/
.env
*.env
*.env.local

# Virtual Environments
venv/
.venv/
env/
bycatch/venv/

# Node.js
node_modules/
frontend/node_modules/
dhaora/frontend/node_modules/
.vite/

# CatchForecast & DHAORA
CatchForecast-AI/models/*/*.joblib
dhaora/data/static/uploads/*
!dhaora/data/static/uploads/.gitkeep
dhaora/data/static/results/*
