dhaora/data/dhaora.db

# Python cache & testing
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
bycatch/.pytest_cache/

# Upload and temporary caches
backend/static/uploads/*
!backend/static/uploads/.gitkeep
backend/static/results/*
!backend/static/results/.gitkeep
bycatch/runs/
*.cache
*.log

# Large public archives (untracked)
dataset_pipeline/data/public/deepfish/raw/*.zip
